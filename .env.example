# Copy to `.env` and fill in.
# Quote values that contain # or intentional edge spaces.
SKYLIGHT_EMAIL=
SKYLIGHT_PASSWORD=
SKYLIGHT_BASIC_TOKEN=
SKYLIGHT_BEARER_TOKEN=
SKYLIGHT_AUTH_HEADER=
SKYLIGHT_API_BASE=https://app.ourskylight.com
SKYLIGHT_API_VERSION=2026-05-01
SKYLIGHT_CALENDAR_URL=
SKYLIGHT_FRAME_ID=
SKYLIGHT_TIMEZONE=
SKYLIGHT_REQUEST_TIMEOUT_MS=30000
# Optional public HTTP MCP deployment URL; local browser OAuth needs no settings.
SKYLIGHT_MCP_HTTP_PUBLIC_URL=
# Only production hosted OAuth needs the following durable-storage settings.
# Token, insecure-local, stdio, and local development modes ignore them.
SKYLIGHT_OAUTH_DB_PATH=
# One 32-byte base64url secret; independent encryption, subject, and signing
# keys are derived from it.
SKYLIGHT_OAUTH_MASTER_KEY=
